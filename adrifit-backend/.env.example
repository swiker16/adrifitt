# Copia este archivo a .env (no se sube a git) y rellena los valores.
# En el servidor, define estas variables en el entorno del servicio.

# Base de datos PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/adrifit
DB_USERNAME=adrifit
DB_PASSWORD=

# Clave de las sesiones (Base64, 256+ bits). Genera una con:
#   PowerShell: [Convert]::ToBase64String((1..64 | % { Get-Random -Max 256 }))
#   Linux/macOS: openssl rand -base64 64
JWT_SECRET=

# Primer entrenador (solo se usa si aún no existe). Sin contraseña se genera una aleatoria
# y se muestra una sola vez en el log.
TRAINER_USERNAME=trainer
TRAINER_EMAIL=
TRAINER_PASSWORD=

# URL pública (enlaces de los emails) y passkeys
PUBLIC_URL=http://localhost:4200
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGINS=http://localhost:4200,http://localhost:4300

# Emails: test (se guardan en la bandeja) o smtp
MAIL_MODE=test
LEADS_NOTIFY_EMAIL=

# Datos de demo (perfil local): contraseña de los clientes de ejemplo
DEMO_PASSWORD=
